{
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "Https": {
                "Url": "https://*:8090"
            }
        },
        "Certificates": {
            "Default": {
                "Path": "/media-secrets/maw-media.pfx"
            }
        }
    },
    "AllowedHosts": "*",
    "DataProtection": {
        "Path": "/media-data-protection"
    },
    "Npgsql": {
        "ConnectionString": "Host=localhost;Port=5432;Database=maw_media;Username=svc_maw_media;Passfile=/media-secrets/npgsql-passfile-svc_maw_media;Application Name=maw-media;Max Auto Prepare=100;GSS Encryption Mode=Disable;"
    },
    "ForwardedHeaders": {
        "KnownNetworks": ["192.168.0.0/16", "169.254.1.2/32"]
    },
    "CorsOriginUrls": ["https://photos.mikeandwan.us"],
    "Assets": {
        "RootDirectory": "/media-assets"
    },
    "Faces": {
        "RootDirectory": "/media-faces"
    },
    "PlaceCovers": {
        "RootDirectory": "/media-place-covers"
    },
    "CategoryDownload": {
        "RootDirectory": "/media-download",
        "CleanIntervalInMinutes": 15,
        "MinAgeBeforeDeleteInMinutes": 300
    },
    "Upload": {
        "RootDirectory": "/media-upload"
    },
    "OAuth": {
        "Authority": "https://login.mikeandwan.us/",
        "Audience": "https://media.mikeandwan.us",
        "ScalarClientId": ""
    },
    "LocationCorrection": {
        "PollIntervalInMinutes": 15,
        "PerItemDelayInMillis": 10,
        "UserId": "to be overriden by secrets"
    }
}
