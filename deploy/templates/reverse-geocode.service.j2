[Unit]
Description=maw-reverse-geocode job

[Service]
Type=oneshot
ExecStart=podman run --rm --replace --add-host=media.mikeandwan.us:host-gateway --authfile {{ podman_authfile }} --pull newer --name {{ container_revgeo }} --user 1654 --read-only --env-file {{ file_revgeo_env }} {{ img_revgeo }} --login-url {{ revgeo_login_url }} --audience {{ revgeo_audience }} --client-id {{ revgeo_client_id }} --media-api-url {{ revgeo_api_url }}
