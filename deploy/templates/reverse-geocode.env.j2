# secrets for the reverse-geocode job, read by `podman run --env-file`.
#
# here rather than on the job's command line, where every user on the host could
# read them through ps or /proc/<pid>/cmdline.  this file is written 0600 into a
# 0700 directory, and a process's environment is readable only by its own user
# and root.  one KEY=VALUE per line, taken literally - no quoting.
REVGEO_CLIENT_SECRET={{ revgeo_client_secret }}
REVGEO_GOOGLE_API_KEY={{ revgeo_google_api_key }}
